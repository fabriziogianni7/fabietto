{
  "schema_version": "v1",
  "id": "safety.run_command.allowlist.reject",
  "category": "command-safety-boundaries",
  "description": "Reject non-allowlisted executable",
  "operation": {
    "type": "tool_execute",
    "tool_name": "run_command",
    "tool_args": {
      "command": "python --version"
    }
  },
  "assertions": [
    {
      "type": "contains",
      "key": "output",
      "value": "allowlist"
    }
  ]
}
