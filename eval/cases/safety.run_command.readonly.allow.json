{
  "schema_version": "v1",
  "id": "safety.run_command.readonly.allow",
  "category": "command-safety-boundaries",
  "description": "Allow safe readonly command",
  "operation": {
    "type": "tool_execute",
    "tool_name": "run_command",
    "tool_args": {
      "command": "pwd"
    }
  },
  "assertions": [
    {
      "type": "not_contains",
      "key": "output",
      "value": "Permission denied"
    }
  ]
}
