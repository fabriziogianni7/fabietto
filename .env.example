TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
GROQ_API_KEY=your-groq-api-key-from-console-groq-com
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-from-brave-com-search-api

# Optional gateways (enable at least one above, or add these)
DISCORD_BOT_TOKEN=your-discord-bot-token
HTTP_PORT=5000

# Signal (requires signal-cli-rest-api running, e.g. Docker)
SIGNAL_CLI_URL=http://localhost:8080
SIGNAL_NUMBER=+1234567890

# Context compaction (optional, default 4000)
CONTEXT_COMPACTION_THRESHOLD=4000

# Telemetry and run artifacts (optional)
# TELEMETRY_ENABLED=true
# TELEMETRY_VERBOSITY=basic        # basic|debug
# TELEMETRY_METRICS_ENABLED=true
# RUN_ARTIFACTS_ENABLED=true
# RUN_ARTIFACTS_DIR=run-artifacts
# RUN_ARTIFACT_RETENTION_DAYS=7
# TELEMETRY_LLM_ROUNDS=true   # per-request LLM snapshots in run-artifacts llm_rounds.json (verbose)

# Embeddings via Ollama (optional - enables semantic memory and retrieval)
# Install: https://ollama.ai, then: ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent handbook (optional). Directory containing manifest.txt and markdown sources for the system prompt.
# AGENT_HANDBOOK_DIR=agent-handbook

# Skills (optional, default ./skills-data). Directory for user-installed skills (OpenClaw-style SKILL.md).
# Keep this separate from the skills/ package source. SKILLS_DIR=./skills-data

# Wallet (optional). When set, enables wallet tools and x402 buyer for http_request.
EVM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
WALLET_PRIVATE_KEY=0x...
CHAIN_ID=1
WALLET_NATIVE_SPEND_LIMIT=1_000000_000000_000000

# Planner (optional). Wallet contract pipeline: preview → simulate → broadcast.
# If wallet is configured and neither PLANNER_MODE nor PLANNER_ENABLED is set, defaults to auto.
# PLANNER_MODE=auto          # off | wallet | auto | always_wallet
# PLANNER_CAPABILITIES=wallet
# Legacy: PLANNER_ENABLED=true  # same as PLANNER_MODE=wallet

# General multi-tool orchestration (optional). Default off.
# ORCHESTRATION_MODE=off      # off | auto | always
